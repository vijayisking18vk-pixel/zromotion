{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.chennairents.in"
        }
      ],
      "destination": "https://chennairents.in/:path*",
      "permanent": true
    },
    {
      "source": "/rent-in-:slug",
      "destination": "/chennai/:slug/",
      "permanent": true
    },
    {
      "source": "/advance-deposit-chennai",
      "destination": "/guide/advance-deposit-chennai/",
      "permanent": true
    },
    {
      "source": "/tenant-rules-chennai",
      "destination": "/guide/tenant-rules-chennai/",
      "permanent": true
    },
    {
      "source": "/map",
      "destination": "/listings/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
